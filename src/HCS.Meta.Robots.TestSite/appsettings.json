{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "bfcb368a-717a-44cc-b5c3-4abfbcfb7481",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Imaging": {
        "HMACSecretKey": "XhcWLUVnGTA2FqH4M7jJH20XcwaJpuQ5\u002B3o/tUWvP2hb65EgtQvTehLz3MuWj44MrKctE8nlRLtodjv6K/kFhQ=="
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "HCS": {
    "Meta": {
      "RobotsEnabled": true,
      "RobotsAddToDefault": true,
      "RobotsEntries": [
        "User-Agent: google\nDisallow: /umbraco-client/"
      ],
      "Llms": {
        "LlmsEnabled": true,
        "DefaultTitle": "LLMS Test Site",
        "DefaultFilePath": "llms/localhost.md",
        "Configurations": [
          {
            "Domain": "localhost",
            "FilePath": "llms/localhost.md",
            "Name": "LLMS Test Site",
            "Summary": "This is a test site for LLMS configuration.",
            "Sections": [
              {
                "Title": "Section One",
                "Url": "/llms/section-one",
                "Description": "An example section link."
              }
            ]
          }
        ]
      }
    }
  }
}